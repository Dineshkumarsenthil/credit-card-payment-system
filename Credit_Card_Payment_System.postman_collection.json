{
  "info": {
    "name": "Credit Card Payment System",
    "description": "Run in order: Register, Login, Add card, Make payment. Django on 8000, FastAPI on 8001. Edit the collection variables (username, password, admin_username, admin_password) first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_django",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "base_fastapi",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "username",
      "value": "testuser"
    },
    {
      "key": "email",
      "value": "testuser@example.com"
    },
    {
      "key": "password",
      "value": "ChangeMe@12345"
    },
    {
      "key": "admin_username",
      "value": "admin"
    },
    {
      "key": "admin_password",
      "value": "ChangeMe@12345"
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    },
    {
      "key": "admin_access",
      "value": ""
    },
    {
      "key": "card_id",
      "value": ""
    },
    {
      "key": "reference",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth (Django)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_django}}/api/auth/register/",
              "host": [
                "{{base_django}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"password2\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_django}}/api/auth/login/",
              "host": [
                "{{base_django}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Returns access and refresh tokens\", function () { pm.expect(j).to.have.property(\"access\"); pm.expect(j).to.have.property(\"refresh\"); });",
                  "pm.collectionVariables.set(\"access\", j.access);",
                  "pm.collectionVariables.set(\"refresh\", j.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
